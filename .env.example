# TensorForge Self-Hosted n8n Environment Configuration
GENERIC_TIMEZONE=Australia/Melbourne
TZ=Australia/Melbourne

# Optional for single-node local Docker (n8n auto-generates and persists a random key in /home/node/.n8n/config if unset).
# Required for multi-worker or stateless deployments (generate with `openssl rand -hex 32`):
# N8N_ENCRYPTION_KEY=

# Downstream API Endpoints & Webhook URLs used by Workflow Blueprints
CLINIKO_API_BASE=https://api.au1.cliniko.com/v1
XERO_TENANT_ID=00000000-0000-0000-0000-000000000000
SLACK_QUARANTINE_WEBHOOK_URL=https://hooks.slack.com/services/T00000000/B00000000/REPLACE_ME
SLACK_TRIAGE_WEBHOOK_URL=https://hooks.slack.com/services/T00000000/B00000000/REPLACE_ME
